# .env.example — copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection used by the app AND by Prisma migrations.
# Local example (matches docs/SETUP.md):
DATABASE_URL="postgresql://msme:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/msme_ledger"

# Separate database used ONLY by integration tests (it is wiped by the tests).
TEST_DATABASE_URL="postgresql://msme:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/msme_ledger_test"

# Auth.js / NextAuth.js
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Public URL of the app (http://localhost:3000 for local development)
NEXTAUTH_URL="http://localhost:3000"

# Log the user out after this many minutes without activity (default 30).
INACTIVITY_TIMEOUT_MINUTES="30"
# Hard upper limit on a single login session, in hours, even if the user stays active.
ABSOLUTE_SESSION_HOURS="12"

# Secret protecting the scheduled-jobs endpoint (/api/jobs/daily). Use a long random value.
CRON_SECRET="REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET"

# Seed passwords (used only by `npm run db:seed` on a development database).
SEED_OWNER_PASSWORD="REPLACE_ME_DEV_ONLY_1"
SEED_DAD_PASSWORD="REPLACE_ME_DEV_ONLY_2"
SEED_CASHIER_PASSWORD="REPLACE_ME_DEV_ONLY_3"
