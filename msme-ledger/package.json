{
  "name": "msme-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "MSME Digital Accounting Ledger for a family vegetable wholesale business, with invoice discounting workflow and credit matchmaker.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "jobs:daily": "tsx --conditions=react-server scripts/run-daily-jobs.ts",
    "user:reset-password": "tsx --conditions=react-server scripts/reset-password.ts",
    "postinstall": "prisma generate",
    "setup:owner": "tsx --conditions=react-server scripts/create-owner.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/react-query": "5.104.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "dexie": "4.4.6",
    "dotenv": "18.0.8",
    "exceljs": "4.4.0",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6",
    "uuid": "11.1.1"
  }
}
